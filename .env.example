# =============================================================================
# NexBot — decoupled, self-hosted fork: environment template
# =============================================================================
# Copy this file to `.env` and fill in the required values. Never commit `.env`.
#
#   NO CopilotKit account, project, organization, or API key is needed.
#   Conversations are stored in your own PostgreSQL; non-conversation state
#   (dots, spaces, pages, tasks, connections, computers) stays in SQLite. The
#   app talks only to the model endpoint you choose. Nothing is sent to
#   CopilotKit, and no CopilotKit telemetry variable is used.
#
# Generate secrets (each 24+ characters):
#   openssl rand -base64 48
#
# Values marked REQUIRED have no safe default: Compose refuses to start without
# them (it uses ${VAR:?} for the required app/postgres variables).
# =============================================================================

# =============================================================================
# REQUIRED
# =============================================================================

# --- Application binding -----------------------------------------------------
# HOST/PORT the server listens on inside the container. Keep 0.0.0.0 so the
# container is reachable; the published port stays bound to host loopback.
HOST=0.0.0.0
PORT=4310
# REQUIRED when HOST is not loopback (24+ characters). Bearer token for the
# owner login and every /api request. Treat it like a password.
OWNER_TOKEN=
# Public address of this server, used for MCP sign-in callbacks behind a proxy
# or on a hosted domain. Defaults to the browser's origin. Set it when the app
# runs behind Caddy/Cloudflare in front of the VPS.
# PUBLIC_URL=https://nexbot.example.com
# Exact browser origin(s) allowed to call the API, comma-separated. Include
# scheme, hostname and port; omit paths and trailing slashes.
# Behind a reverse proxy set this to your public HTTPS origin, e.g.:
#   APP_ORIGIN=https://dots.example.com
# Whitespace around entries is trimmed and empty entries are ignored.
# APP_ORIGIN=https://dots.example.com

# --- Owner identity ----------------------------------------------------------
# Keep OWNER_ID stable: it owns the persistent conversations and other
# owner-scoped state. Changing it after first use orphans that data.
OWNER_ID=nexbot-owner

# --- Non-conversation state: SQLite (REQUIRED) -------------------------------
# File holding dots, spaces, pages, tasks, connections, computers and thread
# bindings. In the container this is a path on the `nexbot-data` volume.
DATABASE_PATH=/data/nexbot.sqlite

# --- Conversations: PostgreSQL (REQUIRED) ------------------------------------
# REQUIRED. Replaces the hosted CopilotKit conversation service.
#   Compose-internal form (the host is the bundled postgres service name):
#     postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
#   With the values below that is:
#     postgres://nexbot:<POSTGRES_PASSWORD>@postgres:5432/nexbot
# Keep DATABASE_URL consistent with the POSTGRES_* values below.
DATABASE_URL=
# Credentials for the bundled `postgres` service in compose.yml.
# It publishes NO host port; it is reachable only on the internal network.
POSTGRES_USER=nexbot
# REQUIRED. Generate one: openssl rand -base64 48
POSTGRES_PASSWORD=
POSTGRES_DB=nexbot

# --- Model endpoint (REQUIRED for agent runs) --------------------------------
# Any OpenAI-compatible endpoint. Point OPENAI_BASE_URL at a self-hosted server
# (Ollama, vLLM, LM Studio) or a hosted provider (OpenAI, OpenRouter, ...).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Extra headers sent to the model endpoint, as a JSON object of strings. Some
# gateways require routing headers. OpenCode Go needs a session header:
#   OPENAI_EXTRA_HEADERS='{"x-opencode-session":"nexbot"}'
# OPENAI_EXTRA_HEADERS=
# Which model API Dot turns use: auto (default), chat-completions, or responses.
# `auto` sends o-series (o1, o3, o4), gpt-6, and deepseek-v4/r1/reasoner models
# through the Responses API and everything else through Chat Completions, which
# is the previous behaviour. Reasoning models reject function tools together
# with reasoning on Chat Completions. If your provider implements Responses for
# a model this list misses, set responses explicitly; if it does not implement
# Responses, set chat-completions.
# DOT_MODEL_API=auto
# Maximum duration for Dot turns and scheduled/background agent runs (ms).
# AGENT_RUN_TIMEOUT_MS=90000

# =============================================================================
# OPTIONAL
# =============================================================================

# --- Setup telemetry ---------------------------------------------------------
# OPTIONAL, unset by default. When unset, NO telemetry leaves the host.
# If set, anonymous setup/version telemetry is POSTed to this URL.
# SETUP_TELEMETRY_ENDPOINT=

# --- Web search --------------------------------------------------------------
# parallel (default), browser (URL-only reader), or disabled.
# With `parallel`, queries and selected URLs are sent to Parallel; set a key
# for authenticated/higher-limit use (anonymous MCP supports light use).
WEB_SEARCH_PROVIDER=parallel
PARALLEL_API_KEY=

# --- Isolated read-only browser (needed only for WEB_SEARCH_PROVIDER=browser) -
# Supply the same random 24+ character secret to the app and browser service.
# All redirects are blocked; use canonical public URLs.
BROWSER_URL=http://127.0.0.1:4311
BROWSER_SECRET=
BROWSER_HOST=127.0.0.1
BROWSER_PORT=4311

# --- Composio connected apps -------------------------------------------------
# Lets Dots use the owner's connected apps. See docs/SETUP.md#composio.
COMPOSIO_API_KEY=

# --- Realtime speech ---------------------------------------------------------
VOICE_API_KEY=
# Realtime endpoint root, for a non-OpenAI gateway (default https://api.openai.com).
# VOICE_BASE_URL=
VOICE_MODEL=
VOICE_NAME=marin

# --- Slack (NOT YET WIRED) ---------------------------------------------------
# OPTIONAL. SLACK_BOT_TOKEN and SLACK_SIGNING_SECRET come from a self-hosted
# Slack integration that replaces @copilotkit/channels in a LATER workstream.
# This build does not read them yet; setting them has no effect today.
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# The managed vars below are still accepted by the current build.
# Match the managed declaration name, not a Slack #conversation name.
# Allowlist both the Slack workspace and explicit Slack user IDs.
SLACK_CHANNEL_NAME=
SLACK_TEAM_ID=
SLACK_USER_IDS=
# SLACK_DOT_ID= (defaults to the initial Dot)

# --- Persistent computers (OpenBot supervisor) -------------------------------
# OPTIONAL, one container per Dot. See docs/COMPUTERS.md.
# Keep these two DIFFERENT random 24+ character secrets on the server.
COMPUTER_SUPERVISOR_URL=
COMPUTER_SUPERVISOR_TOKEN=
COMPUTER_TOKEN=
# Keep stable: the namespace identifies existing containers and volumes.
COMPUTER_NAMESPACE=nexbot
# COMPUTER_MEMORY_BYTES=2147483648
# COMPUTER_RUNTIME=runsc
# ENGINE_SOCKET=/var/run/docker.sock
